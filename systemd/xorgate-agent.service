# xorgate device agent systemd unit.
#
# Installed on each device host by install.sh (served per-request from
# GET /get/:code). The installer drops the built agent at /opt/xorgate, writes
# /etc/xorgate/agent.env with the device identity + cert paths, then:
#
#   install -m 0644 /opt/xorgate/systemd/xorgate-agent.service /etc/systemd/system/
#   systemctl daemon-reload
#   systemctl enable --now xorgate-agent
#
# Prerequisites on the host (all handled by install.sh):
#   - The agent built and installed at /opt/xorgate/dist/worker.js.
#   - /etc/xorgate/agent.env with DEVICE_ID, IOT_DATA_ENDPOINT, CERT_PATH,
#     KEY_PATH, CA_PATH (and optionally MODE=sim|real).
#   - The cert/key files readable by root (chmod 0600).
#
# User=root here is the fallback. install.sh drops in
# `xorgate-agent.service.d/10-user.conf` that overrides it to run the agent as
# the provisioning user (captured from $SUDO_USER), so that operator can inspect
# it without sudo. The agent only needs an outbound mTLS connection, so it does
# not require root.
#
# XORGATE_HOME points at the StateDirectory (/var/lib/xorgate); systemd creates
# and chowns it to the (drop-in) service user, so the worker's pidfile + state
# snapshot are readable by that user. The `xorgate` CLI wrapper installed by
# install.sh defaults to the same path, so `xorgate status`/`monitor` reflect
# THIS running service.

[Unit]
Description=Xorgate device agent (IoT MQTT telemetry)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
EnvironmentFile=/etc/xorgate/agent.env
# systemd creates/owns /var/lib/xorgate (persists across reboots); the worker
# writes its pidfile + state.json there.
StateDirectory=xorgate
StateDirectoryMode=0700
Environment=XORGATE_HOME=/var/lib/xorgate
# Run from the writable StateDirectory. The IMU reader's GPIO backend (lgpio,
# used by Adafruit Blinka on Pi 5) creates `.lgd-nfy*` notify files in the CWD;
# the default service CWD "/" isn't writable by the service user, which makes
# `import board` fail. /var/lib/xorgate is created + owned by the service user.
WorkingDirectory=/var/lib/xorgate
# RGB status LED (plans/rgb_led_events). Both hooks reuse the CLI wrapper
# install.sh already writes — there is no scripts/ dir under /opt/xorgate, so a
# new helper would need a deployment path in the backend installer AND in
# `xorgate update`. They run as the drop-in service user (pi), not root;
# `pinctrl` needs no sudo.
#
# `exit-state` reads $SERVICE_RESULT, which systemd sets for ExecStopPost:
# `success` (systemctl stop/restart, reboot — our SIGTERM path exits 0) blanks
# the LED; a crash (exit-code/signal/core-dump/watchdog/timeout) latches solid
# red. A crash-loop ends red: Restart=always retries, and once StartLimitBurst
# is exhausted systemd gives up with the last ExecStopPost's red still showing.
#
# Both are prefixed `-` so the LED can NEVER stop the agent: without it, a
# non-zero ExecStartPre aborts the start entirely.
ExecStartPre=-/usr/local/bin/xorgate led boot
ExecStart=/usr/bin/env node /opt/xorgate/dist/worker.js
ExecStopPost=-/usr/local/bin/xorgate led exit-state

# Restart on every exit (including a clean exit 0 after SIGTERM). Recovers from
# a brief IoT/cert outage and from operator-induced stops.
Restart=always
RestartSec=5s

# Break crash-loops: 10 failures in 60s and systemd holds off until the operator
# runs `systemctl reset-failed xorgate-agent`.
StartLimitIntervalSec=60
StartLimitBurst=10

[Install]
WantedBy=multi-user.target
