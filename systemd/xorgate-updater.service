[Unit]
Description=Xorgate agent self-update (fetch latest build, install, restart agent)
Documentation=https://github.com/epyelabs/xorgate-device-agent

# Deliberately NO [Install] section: this unit is never enabled and never runs
# on boot. It is started on demand — by hand, or by the agent acting on a
# cloud-issued `update` command via
#   sudo -n systemctl start --no-block xorgate-updater.service
# (exact-match sudoers grant, /etc/sudoers.d/022_xorgate-update).
#
# Why a unit at all, rather than the agent updating itself in-process or
# spawning `sudo xorgate update` as a child:
#   - the agent runs unprivileged (User=pi drop-in); the updater needs root;
#   - a child process would sit in the agent's own cgroup and be killed by the
#     `systemctl restart xorgate-agent` that the update itself performs.
# systemd owns the updater instead, so it survives the restart of its caller,
# and `systemctl start` on an already-activating oneshot coalesces into the
# running job — which is what makes a double-pressed Update button harmless.

[Service]
Type=oneshot
ExecStart=/usr/local/bin/xorgate update
# The default TimeoutStartSec (90s) would SIGTERM the updater in the middle of
# `npm ci`, which alone takes minutes on a CM5 over LTE. `xorgate update` rolls
# back on failure, but a kill mid-swap is a class of failure worth not having.
TimeoutStartSec=20min
# `xorgate update` reads /etc/xorgate/agent.env itself (for the dist bucket URL
# and version), so no EnvironmentFile is needed here.
