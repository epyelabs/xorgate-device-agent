[Unit]
Description=SIM7600 Resilient LTE Connection Manager (xorgate)
Documentation=https://github.com/xorgate/xorgate-device-agent
# Start after basic system init, but before most network-dependent services
After=systemd-udevd.service
Wants=systemd-udevd.service
# Prevent conflict with ModemManager if installed
Conflicts=ModemManager.service

[Service]
Type=simple
ExecStart=/usr/local/bin/sim7600-lte.sh
Restart=always
RestartSec=10

# Configurable overrides via environment (or drop-in override file)
# Create /etc/systemd/system/sim7600-lte.service.d/override.conf to customize:
#   [Service]
#   Environment="SIM7600_SERIAL=/dev/ttyUSB2"
#   Environment="SIM7600_IFACE=usb0"
#   Environment="SIM7600_PING_HOST=8.8.8.8"
#   Environment="SIM7600_MIN_CSQ=10"
#   Environment="SIM7600_GOOD_CSQ=15"
#   Environment="SIM7600_ENABLE_GPS=1"
# GNSS tuning (defaults live in the script):
#   Environment="SIM7600_GNSS_MODE=15"        # extra constellations bitmask (GLO|BDS|GAL|QZSS)
#   Environment="SIM7600_GNSS_DPO=0"          # 1 = duty-cycled power saving
#   Environment="SIM7600_GNSS_XTRA=1"         # XTRA predicted-ephemeris assistance
#   Environment="SIM7600_SUPL_URL=supl.google.com:7276"   # "" = plain standalone
#   Environment="SIM7600_GNSS_ACCURACY=100"   # AT+CGPSHOR meters
# GNSS antenna bias (active vs passive antenna) is NOT an env knob: it comes
# from the agent's settings.json (web device settings page or
# `xorgate set gps-antenna <active|passive>`); missing key = passive/bias off.
#   Environment="SIM7600_SETTINGS_FILE=/var/lib/xorgate/settings.json"  # dev relocation only
Environment="SIM7600_SERIAL=/dev/ttyUSB2"
Environment="SIM7600_IFACE=usb0"
Environment="SIM7600_PING_HOST=8.8.8.8"
Environment="SIM7600_MIN_CSQ=10"
Environment="SIM7600_GOOD_CSQ=15"
Environment="SIM7600_ENABLE_GPS=1"

# Output goes to journald (use: journalctl -u sim7600-lte -f)
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sim7600-lte

# Give the script enough time to wait for signal on startup
TimeoutStartSec=120
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
